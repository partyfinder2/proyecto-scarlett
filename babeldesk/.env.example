# BabelDesk — copia a .env en la raíz (no commitear .env)

STUDIO_MASTER_KEY=cambia-esto-por-una-frase-larga-secreta

# YouTube +18 / IG: sesión Chrome/Edge (Chrome CERRADO al pulsar Descargar; no reabras YouTube antes)
# Si falla "Could not copy Chrome cookie database" → usa data/cookies.txt (ver docs/YTDLP_COOKIES.md)
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FROM_BROWSER=edge
# ALLOW_PLAIN_TOKENS=1

# --- Meta (Page + IG) ---
META_APP_ID=
META_APP_SECRET=
META_OAUTH_PORT=8765
META_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth/meta/callback

# --- TikTok API (opcional; assist manual sin esto) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_PORT=8766
TIKTOK_OAUTH_REDIRECT_URI=http://127.0.0.1:8766/oauth/tiktok/callback
# TIKTOK_OAUTH_SCOPES=user.info.basic,video.upload,video.publish
# TIKTOK_APP_AUDITED=1
# TIKTOK_USE_API=1
